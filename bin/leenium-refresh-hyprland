#!/bin/bash

# leenium:summary=Overwrite all the user configs in ~/.config/hypr with the Leemium defaults.

leenium-refresh-config hypr/autostart.conf
leenium-refresh-config hypr/bindings.conf
leenium-refresh-config hypr/input.conf
leenium-refresh-config hypr/looknfeel.conf
leenium-refresh-config hypr/hyprland.conf
leenium-refresh-config hypr/monitors.conf
bash "$LEENIUM_PATH/install/config/detect-keyboard-layout.sh"