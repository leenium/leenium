#!/bin/bash

# leenium:summary=Launch a TUI or focus an existing terminal window for it
# leenium:args=<command> [args...]

if [[ -z "$1" ]]; then
  echo "Usage: leenium-launch-or-focus-tui <command> [args...]" >&2
  exit 1
fi

APP_ID="org.leenium.$(basename "$1")"
LAUNCH_COMMAND="leenium-launch-tui $*"

exec leenium-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
