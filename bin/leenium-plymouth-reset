#!/bin/bash

# Restore the Plymouth boot theme and the SDDM login screen to the leenium
# defaults — copies the shipped assets into /usr/share, rebuilds the initramfs,
# and refreshes the SDDM theme.

theme_dir="/usr/share/plymouth/themes/leenium"

sudo find ~/.local/share/leenium/default/plymouth -maxdepth 1 -type f -exec cp -t "$theme_dir/" {} +
sudo plymouth-set-default-theme leenium

if leenium-cmd-present limine-mkinitcpio; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi

leenium-refresh-sddm