#!/bin/bash

# leenium:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# leenium:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
leenium-pkg-add heroic-games-launcher-bin
leenium-install-gaming-gpu-lib32

setsid gtk-launch heroic >/dev/null 2>&1 &