#!/bin/bash

# leenium:summary=Install Steam and graphics drivers selected for this system
# leenium:requires-sudo=true

set -e

leenium-pkg-add steam
leenium-install-vulkan-lib32
leenium-install-nvidia-lib32

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid gtk-launch steam >/dev/null 2>&1 &
