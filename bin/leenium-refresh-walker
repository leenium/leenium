#!/bin/bash

# leenium:summary=Overwrite the user configs for the Walker application launcher (which also powers the Leemium Menu) and restart the services.

mkdir -p ~/.config/autostart/
cp "$LEENIUM_PATH/default/walker/walker.desktop" ~/.config/autostart/

# And restarts if it crashes or is killed
mkdir -p ~/.config/systemd/user/app-walker@autostart.service.d/
cp "$LEENIUM_PATH/default/walker/restart.conf" ~/.config/systemd/user/app-walker@autostart.service.d/restart.conf

systemctl --user daemon-reload

# Refresh configs
leenium-refresh-config walker/config.toml
leenium-refresh-config elephant/calc.toml
leenium-refresh-config elephant/desktopapplications.toml

# Link all elephant menus
mkdir -p ~/.config/elephant/menus
for menu in $LEENIUM_PATH/default/elephant/*.lua; do
  ln -snf "$menu" ~/.config/elephant/menus/"$(basename "$menu")"
done

# Restart service
leenium-restart-walker
