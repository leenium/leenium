#!/bin/bash

# leenium:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the Leemium default and rebuild it.
# leenium:requires-sudo=true

sudo cp -r ~/.local/share/leenium/default/plymouth/* /usr/share/plymouth/themes/leenium/
sudo plymouth-set-default-theme leenium

if command -v limine-mkinitcpio &>/dev/null; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi
