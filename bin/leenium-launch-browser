#!/usr/bin/env bash
# Open the default web browser; Firefox if nothing else is set.
# Usage: leenium-launch-browser [--private] [URL ...]
set -euo pipefail

private=0
if [[ "${1:-}" == "--private" ]]; then
  private=1
  shift
fi

firefox_args=()
if (( private )); then
  firefox_args+=(--private-window)
fi

desktop="$(xdg-settings get default-web-browser 2>/dev/null || true)"

if [[ "$desktop" == firefox*.desktop ]]; then
  exec firefox "${firefox_args[@]}" "$@"
fi

if [[ -n "$desktop" ]] && {
  [[ -f "/usr/share/applications/$desktop" ]] ||
    [[ -f "$HOME/.local/share/applications/$desktop" ]]
}; then
  exec gtk-launch "$desktop"
fi

exec firefox "${firefox_args[@]}" "$@"
