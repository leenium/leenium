#!/bin/bash

# leenium:summary=Set the Leemium channel, which dictates what git branch and package repository is used.
# omaleeniumrchy:args=<stable|dev>
# leenium:requires-sudo=true

if (($# == 0)); then
  echo "Usage: leenium-channel-set [stable|rc|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") leenium-branch-set "master" && leenium-refresh-pacman "stable" ;;
"dev") leenium-branch-set "dev" && leenium-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

leenium-update -y