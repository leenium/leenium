#!/bin/bash

# leenium:summary=Install Arch packages if they are missing
# leenium:group=install
# leenium:name=package
# leenium:args=<packages...>
# leenium:examples=leenium install package jq ripgrep
# leenium:requires-sudo=true

if leenium-pkg-missing "$@"; then
  sudo pacman -S --noconfirm --needed "$@" || exit 1
fi

for pkg in "$@"; do
  # Secondary check to handle states where pacman doesn't actually register an error
  if ! pacman -Q "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
