#!/bin/bash

# leenium:summary=Launch the Leenium Menu or takes a parameter to jump straight to a submenu.

# Set to true when going directly to a submenu, so we can exit directly
BACK_TO_EXIT=false
MENU_BACK="__menu_back__"
MENU_EXIT="__menu_exit__"


# ── Menu Engine ───────────────────────────────────────────

back_to() {
  local parent_menu="$1"

  if [[ $BACK_TO_EXIT == "true" ]]; then
    exit 0
  elif [[ -n $parent_menu ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}

toggle_existing_menu() {
  if pgrep -f "walker.*--dmenu" >/dev/null; then
    walker --close >/dev/null 2>&1
    exit 0
  fi
}

menu_with_back() {
  local options="$1"

  if [[ -n $options ]]; then
    printf '%s\n󰌑  Back' "$options"
  else
    printf '󰌑  Back'
  fi
}

menu_with_exit() {
  local options="$1"

  if [[ -n $options ]]; then
    printf '%s\n󰈆  Exit' "$options"
  else
    printf '󰈆  Exit'
  fi
}

menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"
  local preselect="$4"
  local options_to_show="$options"
  local selection=""

  read -r -a args <<<"$extra"

  if [[ $BACK_TO_EXIT == "true" ]]; then
    options_to_show="$options"
  elif [[ $prompt == "Go" ]]; then
    options_to_show=$(menu_with_exit "$options")
  else
    options_to_show=$(menu_with_back "$options")
  fi

  if [[ -n $preselect ]]; then
    local index
    index=$(echo -e "$options_to_show" | grep -nxF "$preselect" | cut -d: -f1)
    if [[ -n $index ]]; then
      args+=("-c" "$index")
    fi
  fi

  selection=$(echo -e "$options_to_show" | leenium-launch-walker --dmenu --width 295 --minheight 1 --maxheight 630 -p "$prompt…" "${args[@]}" 2>/dev/null)

  case $selection in
  "󰌑  Back") echo "$MENU_BACK" ;;
  "󰈆  Exit") echo "$MENU_EXIT" ;;
  *) echo "$selection" ;;
  esac
}


# ── Action Helpers ────────────────────────────────────────

terminal() {
  xdg-terminal-exec --app-id=org.leenium.terminal "$@"
}

present_terminal() {
  leenium-launch-floating-terminal-with-presentation $1
}

run_container_fn() {
  local cmd="$1"
  present_terminal "source \"$HOME/.local/share/leenium/default/bash/fns/containers\" && $cmd"
}

run_network_cmd() {
  local cmd="$1"
  present_terminal "$cmd"
}

open_in_editor() {
  notify-send -u low "Editing config file" "$1"
  leenium-launch-editor "$1"
}

install() {
  present_terminal "echo 'Installing $1...'; leenium-pkg-add $2"
}

install_and_launch() {
  present_terminal "echo 'Installing $1...'; leenium-pkg-add $2 && setsid gtk-launch $3"
}

install_font() {
  present_terminal "echo 'Installing $1...'; leenium-pkg-add $2 && sleep 2 && leenium-font-set '$3'"
}

install_terminal() {
  present_terminal "leenium-install-terminal $1"
}

aur_install() {
  present_terminal "echo 'Installing $1 from AUR...'; leenium-pkg-aur-add $2"
}

aur_install_and_launch() {
  present_terminal "echo 'Installing $1 from AUR...'; leenium-pkg-aur-add $2 && setsid gtk-launch $3"
}


# ── Main Menu & Router ────────────────────────────────────

show_main_menu() {
  # go_to_menu "$(menu "Go" "󰀻  Apps\n󰧑  Learn\n󱓞  Trigger\n  Containers\n  Style\n  Settings\n󰘦  Config\n󰏗  Packages\n  Update\n  About\n  System")"
  go_to_menu "$(menu "Go" "󰀻  Apps\n󰧑  Learn\n󱓞  Actions\n  Appearance\n󱧘  Install\n󱧗  Remove\n  Settings\n  Update\n  About\n  System")"
}

go_to_menu() {
  case "${1,,}" in
  *apps*) walker -p "Launch…" ;;
  *learn*) show_learn_menu ;;
  *action*) show_action_menu ;;
  # *containers*) show_containers_menu ;;
  *appearance*) show_appearance_menu ;;
  *install*) show_install_menu ;;
  *remove*) show_remove_menu ;;
  *settings*) show_settings_menu ;;
  *update*) show_update_menu ;;
  *about*) show_about ;;
  *system*) show_system_menu ;;

  *share*) show_share_menu ;;
  *toggle*) show_toggle_menu ;;
  *hardware*) show_hardware_menu ;;
  *background*) show_background_menu ;;
  *capture*) show_capture_menu ;;
  *theme*) show_theme_menu ;;
  *screenrecord*) show_screenrecord_menu ;;
  *power*) show_setup_power_menu ;;
  esac
}


# ── Learn ─────────────────────────────────────────────────

show_learn_menu() {
  local options="\
    Keybindings
    Leenium
    Hyprland
  󰣇  Arch
    Neovim
  󱆃  Bash
  "

  case $(menu "Learn" "$options") in
  "$MENU_BACK") show_main_menu ;;
  "$MENU_EXIT") exit 0 ;;
  *Keybindings*) leenium-menu-keybindings ;;
  *Leenium*) leenium-launch-webapp "https://leenium.org/manual/" ;;
  *Hyprland*) leenium-launch-webapp "https://wiki.hypr.land/" ;;
  *Arch*) leenium-launch-webapp "https://wiki.archlinux.org/title/Main_page" ;;
  *Bash*) leenium-launch-webapp "https://devhints.io/bash" ;;
  *Neovim*) leenium-launch-webapp "https://nvchad.com/docs/features#nvcheatsheet" ;;
  *) show_main_menu ;;
  esac
}


# ── Actions ───────────────────────────────────────────────

show_action_menu() {
  local options="\
    Capture
    Share
  "

  case $(menu "Actions" "$options") in
  "$MENU_BACK") show_main_menu ;;
  "$MENU_EXIT") exit 0 ;;
  *Capture*) show_capture_menu ;;
  *Share*) show_share_menu ;;
  *) show_main_menu ;;
  esac
}

show_capture_menu() {
  case $(menu "Capture" "  Screenshot\n  Screenrecord\n󰴑  Text Extraction\n󰃉  Color") in

  "$MENU_BACK") back_to show_action_menu ;;
  "$MENU_EXIT") exit 0 ;;
  *Screenshot*) leenium-capture-screenshot ;;
  *Screenrecord*) show_screenrecord_menu ;;
  *Text*) leenium-capture-text-extraction ;;
  *Color*) pkill hyprpicker || hyprpicker -a ;;
  *) back_to show_action_menu ;;
  esac
}

get_webcam_list() {
  v4l2-ctl --list-devices 2>/dev/null | while IFS= read -r line; do
    if [[ $line != $'\t'* && -n $line ]]; then
      local name="$line"
      IFS= read -r device || break
      device=$(echo "$device" | tr -d '\t' | head -1)
      [[ -n $device ]] && echo "$device  $name"
    fi
  done
}

show_webcam_select_menu() {
  local devices=$(get_webcam_list)
  local count=$(echo "$devices" | grep -c . 2>/dev/null || echo 0)

  if [[ -z $devices ]] || ((count == 0)); then
    notify-send "No webcam devices found" -u critical -t 3000
    return 1
  fi

  if ((count == 1)); then
    echo "$devices" | awk '{print $1}'
  else
    local selected
    selected=$(menu "Select Webcam" "$devices")

    if [[ $selected == "$MENU_BACK" || $selected == "$MENU_EXIT" || -z $selected ]]; then
      return 1
    fi

    echo "$selected" | awk '{print $1}'
  fi
}

show_screenrecord_menu() {
  leenium-capture-screenrecording --stop-recording && exit 0

  local options="\
    With no audio
    With desktop audio
    With desktop + microphone audio
    With desktop + microphone audio + webcam
  "

  case $(menu "Screenrecord" "$options") in

  "$MENU_BACK") back_to show_capture_menu ;;
  "$MENU_EXIT") exit 0 ;;
  *"With no audio") leenium-capture-screenrecording ;;
  *"With desktop audio") leenium-capture-screenrecording --with-desktop-audio ;;
  *"With desktop + microphone audio") leenium-capture-screenrecording --with-desktop-audio --with-microphone-audio ;;
  *"With desktop + microphone audio + webcam")
    local device=$(show_webcam_select_menu) || {
      back_to show_capture_menu
      return
    }
    leenium-capture-screenrecording --with-desktop-audio --with-microphone-audio --with-webcam --webcam-device="$device"
    ;;
  *) back_to show_capture_menu ;;
  esac
}

show_share_menu() {
  local options="\
    Clipboard
    File 
    Folder
  "

  case $(menu "Share" "$options") in
  "$MENU_BACK") back_to show_action_menu ;;
  "$MENU_EXIT") exit 0 ;;
  *Clipboard*) leenium-menu-share clipboard ;;
  *File*) terminal bash -c "leenium-menu-share file" ;;
  *Folder*) terminal bash -c "leenium-menu-share folder" ;;
  *) back_to show_action_menu ;;
  esac
}

# ── Appearance ────────────────────────────────────────────

show_appearance_menu() {
  local options="\
  󰸌  Theme
  󰟵  Unlock
    Font
    Background
    Hyprland
  󱄄  Screensaver
    About
  "

  case $(menu "Appearance" "$options") in

  "$MENU_BACK") show_main_menu ;;
  "$MENU_EXIT") exit 0 ;;
  *Theme*) show_theme_menu ;;
  *Unlock*) leenium-launch-walker -m menus:leeniumunlocks --width 800 --minheight 400 ;;
  *Font*) show_font_menu ;;
  *Background*) show_background_menu ;;
  *Hyprland*) open_in_editor ~/.config/hypr/looknfeel.conf ;;
  *Screensaver*) show_screensaver_menu ;;
  *About*) open_in_editor ~/.config/leenium/branding/about.txt ;;
  *) show_main_menu ;;
  esac
}

show_theme_menu() {
  leenium-launch-walker -m menus:leeniumthemes --width 800 --minheight 400
}

show_background_menu() {
  leenium-launch-walker -m menus:leeniumBackgroundSelector --width 800 --minheight 400
}

show_font_menu() {
  theme=$(menu "Font" "$(leenium-font-list)" "--width 350" "$(leenium-font-current)")
  if [[ $theme == "CNCLD" || -z $theme ]]; then
    back_to show_appearance_menu
  else
    leenium-font-set "$theme"
  fi
}

show_screensaver_menu() {
  local options="\
    Set From Image
    Restore Default
    Edit Text
  󱄄  Preview
  "

  case $(menu "Screensaver" "$options") in
  
  *Image*) set_screensaver_from_image ;;
  *Default*) terminal bash -lc 'leenium-screensaver-set-logo default; echo; read -n 1 -s -r -p "Press any key to close..."' ;;
  *Text*) open_in_editor ~/.config/leenium/branding/screensaver.txt ;;
  *Preview*) leenium-launch-screensaver force ;;
  *) show_style_menu ;;
  esac
}

set_screensaver_from_image() {
  terminal bash -lc '
    image=$(fd --type file --ignore-case --extension svg --extension png . "$HOME" 2>/dev/null | fzf --prompt "Logo image> ")
    if [[ -n $image ]]; then
      if leenium-screensaver-set-logo "$image"; then
        echo
        echo "Preview with: leenium-launch-screensaver force"
      fi
      echo
      read -n 1 -s -r -p "Press any key to close..."
    fi
  '
}

# ── Install ───────────────────────────────────────────────

show_install_menu() {
  local options="\
   󰣇  PACMAN
   󰣇  AUR
     Web App
     TUI
     Service
     Style
   󰵮  Development
     Editor
     Terminal
   󱚤  AI
   󰍲  Windows
     Gaming
  "
  case $(menu "Install" "$options") in

  *PACMAN*) terminal leenium-pkg-install ;;
  *AUR*) terminal leenium-pkg-aur-install ;;
  *Web*) present_terminal leenium-webapp-install ;;
  *TUI*) present_terminal leenium-tui-install ;;
  *Service*) show_install_service_menu ;;
  *Style*) show_install_style_menu ;;
  *Development*) show_install_development_menu ;;
  *Editor*) show_install_editor_menu ;;
  *Terminal*) show_install_terminal_menu ;;
  *AI*) show_install_ai_menu ;;
  *Windows*) present_terminal "leenium-windows-vm install" ;;
  *Gaming*) show_install_gaming_menu ;;
  *) show_main_menu ;;
  esac
}

show_install_service_menu() {
  local options="\
     Tailscale
   󱇱  NordVPN [AUR]
     Telegram
   󰭹  Signal
     Discord
     Chromium Account
   󰏖  ONCE [AUR]
  "
  case $(menu "Install" "$options") in

  *Tailscale*) present_terminal leenium-install-tailscale ;;
  *NordVPN*) present_terminal leenium-install-nordvpn ;;
  # *Bitwarden*) install_and_launch "Bitwarden" "bitwarden bitwarden-cli" "bitwarden" ;;
  # *Thunderbird*) install "Thunderbird" "thunderbird" ;;
  *Telegram*) install "Telegram" "telegram-desktop" ;;
  *Signal*) install "Signal" "signal-desktop" ;;
  *Discord*) install "Discord" "discord" ;;
  *Chromium*) present_terminal leenium-install-chromium-google-account ;;
  *ONCE*) present_terminal leenium-install-once ;;
  *) show_install_menu ;;
  esac
}

show_install_style_menu() {
  local options="\
  󰸌  Theme
    Background
    Font
  "

  case $(menu "Install" "$options") in
  *Theme*) present_terminal leenium-theme-install ;;
  *Background*) leenium-theme-bg-install ;;
  *Font*) show_install_font_menu ;;
  *) show_install_menu ;;
  esac
}

show_install_font_menu() {
  local options="\
    Cascadia Mono
    Meslo LG Mono
    Fira Code
    Victor Code
    Bitstream Vera Mono
    Iosevka
  "
  case $(menu "Install" "$options" "--width 350") in

  *Cascadia*) install_font "Cascadia Mono" "ttf-cascadia-mono-nerd" "CaskaydiaMono Nerd Font" ;;
  *Meslo*) install_font "Meslo LG Mono" "ttf-meslo-nerd" "MesloLGL Nerd Font" ;;
  *Fira*) install_font "Fira Code" "ttf-firacode-nerd" "FiraCode Nerd Font" ;;
  *Victor*) install_font "Victor Code" "ttf-victor-mono-nerd" "VictorMono Nerd Font" ;;
  *Bitstream*) install_font "Bitstream Vera Code" "ttf-bitstream-vera-mono-nerd" "BitstromWera Nerd Font" ;;
  *Iosevka*) install_font "Iosevka" "ttf-iosevka-nerd" "Iosevka Nerd Font Mono" ;;
  *) show_install_menu ;;
  esac
}

