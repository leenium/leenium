#!/bin/bash

# leenium:summary=Reboot after closing application windows
# leenium:examples=leenium reboot | leenium system reboot
# leenium:aliases=leenium reboot

leenium-state clear re*-required

# Schedule the reboot to happen after closing windows (detached from terminal)
nohup bash -c "sleep 2 && systemctl reboot --no-wall" >/dev/null 2>&1 &

# Now close all windows
leenium-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
