#!/bin/bash

# leenium:summary=Enable, disable, toggle, or recover the internal laptop display
# leenium:args=<on|off|toggle|recover>

TOGGLE="internal-monitor-disable"
TOGGLE_FLAG="$HOME/.local/state/leenium/toggles/hypr/$TOGGLE.conf"
MIRROR_TOGGLE="internal-monitor-mirror"
HYPR_CONF="$HOME/.config/hypr/hyprland.conf"

# Get internal monitor name dynamically
INTERNAL=$(hyprctl monitors -j | jq -r '.[] | select(.name | contains("eDP")).name' | head -n 1)

ensure_toggle_source_enabled() {
  if ! grep -Eq '^[[:space:]]*source[[:space:]]*=[[:space:]]*~/.local/state/leenium/toggles/hypr/\*\.conf([[:space:]]*(#.*)?)?$' "$HYPR_CONF"; then
    notify-send -u normal "󰍹    Toggle source missing in hyprland.conf"
    echo "Missing required source line in $HYPR_CONF: source = ~/.local/state/leenium/toggles/hypr/*.conf" >&2
    exit 1
  fi
}

enable() {
  if leenium-hyprland-toggle-enabled "$TOGGLE"; then
    leenium-hyprland-toggle --disabled-notification "󰍹    Laptop display enabled" "$TOGGLE"
  fi
}

disable() {
  if ! leenium-hw-external-monitors; then
    notify-send -u low "󰍹    Can't disable the only active display"
    exit 1
  fi
  if leenium-hyprland-toggle-disabled "$TOGGLE" && leenium-hyprland-toggle-disabled "$MIRROR_TOGGLE"; then
    echo "monitor=$INTERNAL,disable" >"$TOGGLE_FLAG"
    notify-send -u low "󰍹    Laptop display disabled"
    hyprctl reload
  fi
}

recover() {
  if ! leenium-hw-external-monitors && leenium-hyprland-toggle-enabled "$TOGGLE"; then
    leenium-hyprland-toggle "$TOGGLE"
  fi
}

case "$1" in
  on) ensure_toggle_source_enabled; enable ;;
  off) ensure_toggle_source_enabled; disable ;;
  toggle) ensure_toggle_source_enabled; if leenium-hyprland-toggle-enabled "$TOGGLE"; then enable; else disable; fi ;;
  recover) ensure_toggle_source_enabled; recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac