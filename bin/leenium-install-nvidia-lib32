#!/bin/bash

# leenium:summary=Install the lib32 NVIDIA driver matching the detected GPU generation (no-op if no NVIDIA).
# leenium:requires-sudo=true

set -e

if leenium-hw-nvidia-gsp; then
  leenium-pkg-add lib32-nvidia-utils
elif leenium-hw-nvidia-without-gsp; then
  leenium-pkg-add lib32-nvidia-580xx-utils
fi